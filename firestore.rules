rules_version = '2';

// ============================================================================
// San Roque ES — Firestore Security Rules
// Deploy: Firebase Console → Build → Firestore Database → Rules → paste →
// Publish. See README_FIRESTORE_MIGRATION.md, Part 3.
//
// Role model: a user's role/status lives in users/{uid}. Every rule below
// looks that document up (get()) to decide what the caller may do — this is
// the real access control. The website's own role checks (isSchoolAdmin(),
// canManageLearners() in app-config.js) are for showing/hiding UI only and
// are NOT a security boundary by themselves.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return isSignedIn() && myProfile().data.status == "Active" ? myProfile().data.role : "";
    }
    function isAdmin() { return myRole() == "School Admin"; }
    function isStaff() { return myRole() in ["School Admin", "Registrar", "Teacher"]; }

    // --- Users: everyone signed in can read the directory (needed for
    // dropdowns like "adviser"), but only an admin can create/edit/remove
    // accounts. A user may always read (not write) their own document, even
    // before an admin has assigned them a role, so the login flow can tell
    // them their account is pending.
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name"]));
    }

    // --- School years / sections / settings: small reference data. Any
    // signed-in user can read it (needed to populate the UI); only the admin
    // can change the school structure and settings.
    match /schoolYears/{yearId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /sections/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    // Login-page aggregate only. This document must never contain learner
    // names, IDs, or other personally identifiable information.
    match /publicStats/{statId} {
      allow get: if statId == "summary";
      allow list: if false;
      allow write: if isStaff() && statId == "summary";
    }

    // Archived records are kept separate from active learners by school year.
    match /Dropouts/{schoolYear}/records/{learnerId} {
      allow read, write: if isStaff();
    }
    match /TransferredOut/{schoolYear}/records/{learnerId} {
      allow read, write: if isStaff();
    }

    // --- Learners: Learners/{schoolYear}/records/{learnerId}.
    // Staff (admin/registrar/teacher) can read and write. A signed-in
    // Visitors never read this collection. They read only publicStats/summary,
    // which contains aggregate dashboard data and no learner documents.
    match /Learners/{schoolYear}/records/{learnerId} {
      allow read, write: if isStaff();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
